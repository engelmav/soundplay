#!/bin/bash

set -e # Exit immediately if a command exits with a non-zero status.

# --- Log and PID File Configuration ---
LOG_FILE="$HOME/soundplay.log"
PID_FILE="/tmp/soundplay.pids"

# --- Sound Card Auto-Detection ---
echo "Attempting to auto-detect DAC8X sound card..."
DETECTED_CARD_ID=""
# Read /proc/asound/cards to find the DAC8X
while IFS= read -r line || [[ -n "$line" ]]; do
    # Check if the line contains 'dac8x' (case-insensitive)
    if echo "$line" | grep -iq "dac8x"; then
        # Extract the card number (the first field on the line)
        DETECTED_CARD_ID=$(echo "$line" | awk '{print $1}')
        break
    fi
done < /proc/asound/cards

if [ -n "$DETECTED_CARD_ID" ]; then
    ALSA_DEVICE_NAME="hw:$DETECTED_CARD_ID"
    echo "Found DAC8X as card $DETECTED_CARD_ID. Using ALSA device: $ALSA_DEVICE_NAME"
else
    echo "ERROR: DAC8X sound card not found automatically."
    echo "Please ensure it is connected and recognized by ALSA (check 'aplay -l' or '/proc/asound/cards')."
    echo "You may need to manually set ALSA_DEVICE_NAME in this script."
    exit 1
fi
# --- End Sound Card Auto-Detection ---


# Configuration Variables
JACKD_CMD="jackd"
# ALSA_DEVICE_NAME is now set by auto-detection above
JACKD_ARGS="-d alsa -P -d ${ALSA_DEVICE_NAME} -r 48000 -p 1024 -n 2 -o 8" # -i N for N inputs if needed

LIBRESPOT_CMD="/home/vcaudo/librespot/target/release/librespot"
LIBRESPOT_ARGS="--backend jackaudio --initial-volume 15"
JALV_CMD="jalv.gtk"
XOVER_PLUGIN_URI="http://lsp-plug.in/plugins/lv2/crossover_stereo"
XOVER_CONFIG_DIR="$HOME/xover_80hz/" # Using $HOME for robust path expansion

LIBRESPOT_JACK_CLIENT="librespot"
XOVER_JACK_CLIENT_PREFIX="LSP Crossover Stereo x8" # Prefix used by jalv for LSP plugins

# --- Function Definitions ---

start() {
    if [ -f "$PID_FILE" ]; then
        echo "Services appear to be running. PID file exists: $PID_FILE"
        echo "If services are stopped, please remove the file and try again."
        exit 1
    fi

    echo "Starting services in the background..."
    echo "Log output will be sent to $LOG_FILE"

    # Run the main startup logic in a backgrounded subshell
    # This allows the 'start' command to exit immediately while the services run.
    (
        # Redirect all output from this point forward within the subshell to the log file
        exec > "$LOG_FILE" 2>&1
        set -e # Ensure subshell exits on error

        echo "--- Starting new session at $(date) ---"

        # Clear old PIDs and create a new PID file
        > "$PID_FILE"

        echo "Starting JACK Audio Server (jackd) with device ${ALSA_DEVICE_NAME}..."
        $JACKD_CMD $JACKD_ARGS &
        JACK_PID=$!
        echo $JACK_PID >> "$PID_FILE"
        echo "JACKD started with PID: $JACK_PID"

        sleep 5 # Allow time for JACK server to initialize

        if ! ps -p $JACK_PID > /dev/null; then
            echo "ERROR: jackd process failed to start. Check logs for details."
            exit 1
        fi
        echo "jackd appears to have started successfully."

        echo "Starting Librespot..."
        $LIBRESPOT_CMD $LIBRESPOT_ARGS &
        LIBRESPOT_PID=$!
        echo $LIBRESPOT_PID >> "$PID_FILE"
        echo "Librespot started with PID: $LIBRESPOT_PID"
        sleep 2

        echo "Starting LSP Crossover plugin with JALV..."
        $JALV_CMD $XOVER_PLUGIN_URI -l $XOVER_CONFIG_DIR &
        JALV_PID=$!
        echo $JALV_PID >> "$PID_FILE"
        echo "JALV started with PID: $JALV_PID"
        sleep 4

        echo "Connecting JACK ports..."
        jack_connect "${LIBRESPOT_JACK_CLIENT}:out_0" "${XOVER_JACK_CLIENT_PREFIX}:in_l"
        jack_connect "${LIBRESPOT_JACK_CLIENT}:out_1" "${XOVER_JACK_CLIENT_PREFIX}:in_r"
        jack_connect "${XOVER_JACK_CLIENT_PREFIX}:out_l" "system:playback_1"
        jack_connect "${XOVER_JACK_CLIENT_PREFIX}:out_r" "system:playback_2"
        jack_connect "${XOVER_JACK_CLIENT_PREFIX}:band0l" "system:playback_3"
        jack_connect "${XOVER_JACK_CLIENT_PREFIX}:band0r" "system:playback_3"

        echo "Audio setup complete. Services are running in the background."

    ) & # Detach the subshell to run in the background

    echo "Services are starting. Use './player log' to monitor or './player stop' to terminate."
}

stop() {
    if [ ! -f "$PID_FILE" ]; then
        echo "Services not running (or PID file not found at $PID_FILE)."
        exit 1
    fi

    echo "Stopping services..."
    # Read PIDs into an array, handling potential empty lines
    PIDS=()
    while IFS= read -r pid; do
        [ -n "$pid" ] && PIDS+=("$pid")
    done < "$PID_FILE"

    if [ ${#PIDS[@]} -ne 0 ]; then
        echo "Stopping PIDs: ${PIDS[*]}"
        # Kill all processes gracefully first
        kill ${PIDS[*]} 2>/dev/null || true
        sleep 2
        # Force kill any that remain
        kill -9 ${PIDS[*]} 2>/dev/null || true
    else
        echo "PID file was empty. No processes to stop."
    fi

    rm -f "$PID_FILE"
    echo "Services stopped and PID file removed."
}

log() {
    if [ ! -f "$LOG_FILE" ]; then
        echo "Log file not found: $LOG_FILE"
        echo "Have the services been started yet?"
        exit 1
    fi
    echo "Tailing log file: $LOG_FILE (Press Ctrl+C to exit)"
    tail -f "$LOG_FILE"
}


# --- Main Script Logic ---
COMMAND="$1"

if [ -z "$COMMAND" ]; then
    echo "Usage: $0 {start|stop|log}"
    exit 1
fi

case "$COMMAND" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    log|logtail)
        log
        ;;
    *)
        echo "Error: Unknown command '$COMMAND'"
        echo "Usage: $0 {start|stop|log}"
        exit 1
        ;;
esac

exit 0